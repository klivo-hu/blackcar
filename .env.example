# Black Car Autókozmetika — környezeti változók
#
# Másold `.env` néven a projekt gyökerébe, és töltsd ki. A `.env` a
# `.gitignore`-ban és a `.dockerignore`-ban is szerepel: soha ne kerüljön
# verziókövetésbe és ne másolódjon az image-be. A compose `env_file`-ként
# olvassa be, futásidőben.
#
# A `.env` átírása után a konténert újra kell indítani:
#   docker compose up -d --force-recreate


# =============================================================================
# Az oldal címe
# =============================================================================
#
# FIGYELEM: ez az érték **build időben** ég bele a kliens bundle-be, nem a
# konténer indulásakor olvasódik. A `.env`-ben itt hagyva a futásidejű kód
# látja, a böngészőbe került kód viszont a build argumentumot használja —
# ezért a valódi helye a `docker-compose.yml` `args` szakasza. Itt csak azért
# szerepel, hogy a helyi `npm run dev` is a helyes címet lássa.
NEXT_PUBLIC_SITE_URL=https://blackcar60.hu


# =============================================================================
# Admin belépés
# =============================================================================

ADMIN_USERNAME=admin

# A munkamenet-token aláíró kulcsa. Legalább 32 karakter.
# Előállítás:  npm run gen:secret
# Az érték cseréje azonnal érvényteleníti az összes élő munkamenetet.
ADMIN_JWT_SECRET=

# A jelszó PBKDF2 hash-e. A jelszót magát sehol nem tároljuk.
# Előállítás:  npm run gen:password -- "a jelszavad"
#
# A formátum elválasztója PONT, nem dollárjel: a dotenv a `$210000`-t változó
# hivatkozásként értelmezné és kifejtené, némán elrontva a hash-t.
ADMIN_PASSWORD_HASH=


# =============================================================================
# Cégadatok a jogi tájékoztatókhoz
# =============================================================================
#
# Ezek **csak akkor jelennek meg** az oldalon, ha a foglalás be van kapcsolva —
# akkor viszont kötelezőek. Ami itt üresen marad, az az oldalon
# [szögletes zárójeles] helyőrzőként jelenik meg, és a strukturált adatból
# kimarad. Ez szándékos: kitöltetlen cégadatokkal ne lehessen élesíteni.
#
# A `lib/organization.ts` olvassa be őket. Az e-mail cím és a telefonszám NEM
# itt van: azt a tulajdonos szerkeszti az admin felületen.

COMPANY_LEGAL_NAME=
COMPANY_POSTCODE=3000
COMPANY_CITY=Hatvan
COMPANY_STREET=
COMPANY_TAX_NUMBER=
COMPANY_REGISTRATION_NUMBER=
COMPANY_REPRESENTATIVE=

# A tárhelyszolgáltató neve és elérhetősége — az impresszum kötelező eleme.
COMPANY_HOSTING_PROVIDER=

# Felügyeleti szerv (jellemzően a területileg illetékes kormányhivatal
# fogyasztóvédelmi főosztálya).
COMPANY_SUPERVISORY_AUTHORITY=

# Békéltető testület a fogyasztói jogvitákhoz (Heves vármegyei).
COMPANY_DISPUTE_RESOLUTION=

# Meddig őrizzük a foglalási adatokat — az adatkezelési tájékoztatóba kerül.
# Például: "a foglalás napjától számított 1 évig"
COMPANY_BOOKING_RETENTION=

# A jogi dokumentumok hatálybalépése. Például: 2026. január 1.
COMPANY_EFFECTIVE_DATE=

# A telephely koordinátái a `LocalBusiness` strukturált adathoz. Üresen hagyva
# a `geo` mező egyszerűen kimarad — rossz koordináta rosszabb, mint semmi.
# Tizedes fokban, például: 47.6667 / 19.6806
COMPANY_LATITUDE=
COMPANY_LONGITUDE=
